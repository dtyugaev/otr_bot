mI4ODQ1ODc3ZDk1M2Q1MGViZTU4YjJhNTg4MmE1MTY5OWY0YjFmYWE2NzA1IiwiaXNzIjoic2VydmljZWRlc2stand0LXRva2VuLWlzc3VlciIsImNvbnRleHQiOnsidXNlciI6ImtvbnN0YW50aW5vdmEudWx5YW5hIiwiaXNzdWUiOiJJVC0xMjE1NDYifSwiZXhwIjoxNzMxNDk0ODcyLCJpYXQiOjE3MjkwNzU2NzJ9.coyhuNT35aOmTAyDkWpYZwErC69o7pG9BuxUXO1oWe4]{color:#172B4D}{color}  \n\n{color:#7A869A}Это сообщение создано автоматически{color}'}, {'created': 1729087770144, 'authorFullName': 'Ванхольская Вероника Владимировна', 'body': 'Подскажите, пожалуйста, а какой именно лист согласования выбирали?\r\n\r\n!image-2024-10-16-17-08-50-579.png|width=385,height=317!'}], 'userDisplayName': 'Ванхольская Вероника Владимировна', 'reporterEmail': 'egorova.ulyana@otr.ru', 'transitDate': 1729087770207}] (monitoring.py:94)
