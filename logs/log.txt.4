значений\r\n||Тип ресурса||ВПР/НЕТ||Ставка||\r\n|Производственный|Нет|> 0|\r\n|Производственный|ВПР|= 0 |\r\n| Непроизводственный|ВПР|= 0|'}], 'userDisplayName': 'Новиков Сергей Анатольевич', 'reporterEmail': 'vlasova.anna@otr.ru', 'transitDate': 1729155929309}] (monitoring.py:94)
